# Optional. Without it the site runs on the curated catalog and needs no key.
# Get one free at https://www.themoviedb.org/settings/api - either v3 key or v4 bearer token.
TMDB_API_KEY=

# Optional. Defaults to 6967 and 127.0.0.1.
PORT=6967
HOST=127.0.0.1

# Optional. Real AI agent (OpenAI-compatible chat completions + tools).
# Without a key the admin chat uses the built-in command agent.
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# Free local model instead of a cloud key: install Ollama, then
#   ollama pull qwen2.5-coder:7b
# and use these values. The API key is ignored by Ollama.
# AI_API_KEY=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5-coder:7b

# Optional. Where library.json, media.json and the downloaded files live.
# Defaults to ./data beside the server. Point it at a mounted volume in a
# container so state survives a redeploy.
# DATA_DIR=/data
