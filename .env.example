# Optional. Without it the site runs on the curated catalog and needs no key.
# Get one free at https://www.themoviedb.org/settings/api - either v3 key or v4 bearer token.
TMDB_API_KEY=

# Optional. Defaults to 6967 and 127.0.0.1.
PORT=6967
HOST=127.0.0.1

# Optional. An OpenAI-compatible model for the two admin agents (chat + tools).
# Without one, both agents still work: file browsing, search, syntax checks and
# the site doctor are answered straight from disk in milliseconds, and the
# admin chat runs its built-in command set. A model only adds free-form writing,
# explanations and code proposals.
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Optional. Where library.json, media.json and the downloaded files live.
# Defaults to ./data beside the server. Point it at a mounted volume in a
# container so state survives a redeploy.
# DATA_DIR=/data
