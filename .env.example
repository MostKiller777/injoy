# Optional. Without it the site runs on the curated catalog and needs no key.
# Get one free at https://www.themoviedb.org/settings/api - either v3 key or v4 bearer token.
TMDB_API_KEY=

# Optional. Defaults to 6967 and 127.0.0.1.
PORT=6967
HOST=127.0.0.1

# Optional. Where library.json, media.json and the downloaded files live.
# Defaults to ./data beside the server. Point it at a mounted volume in a
# container so state survives a redeploy.
# DATA_DIR=/data
